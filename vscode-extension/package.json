{
  "name": "playclone-vscode",
  "displayName": "PlayClone Browser Automation",
  "description": "Interactive browser automation recorder and debugger for PlayClone",
  "version": "1.0.0",
  "publisher": "playclone",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "testing",
    "recorder"
  ],
  "activationEvents": [
    "onCommand:playclone.startRecording",
    "onCommand:playclone.stopRecording",
    "onCommand:playclone.runScript",
    "onCommand:playclone.showSelector",
    "onCommand:playclone.openBrowser",
    "onCommand:playclone.closeBrowser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "playclone.startRecording",
        "title": "PlayClone: Start Recording",
        "icon": "$(record)"
      },
      {
        "command": "playclone.stopRecording",
        "title": "PlayClone: Stop Recording",
        "icon": "$(stop)"
      },
      {
        "command": "playclone.runScript",
        "title": "PlayClone: Run Script",
        "icon": "$(play)"
      },
      {
        "command": "playclone.showSelector",
        "title": "PlayClone: Show Selector Builder",
        "icon": "$(search)"
      },
      {
        "command": "playclone.openBrowser",
        "title": "PlayClone: Open Browser",
        "icon": "$(browser)"
      },
      {
        "command": "playclone.closeBrowser",
        "title": "PlayClone: Close Browser",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "playclone.startRecording",
          "group": "navigation",
          "when": "!playclone.recording"
        },
        {
          "command": "playclone.stopRecording",
          "group": "navigation",
          "when": "playclone.recording"
        },
        {
          "command": "playclone.runScript",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "playclone",
          "title": "PlayClone",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "playclone": [
        {
          "id": "playclone.recorder",
          "name": "Recorder",
          "type": "webview"
        },
        {
          "id": "playclone.selector",
          "name": "Selector Builder",
          "type": "webview"
        },
        {
          "id": "playclone.browser",
          "name": "Browser Preview",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "PlayClone",
      "properties": {
        "playclone.browser": {
          "type": "string",
          "default": "chromium",
          "enum": ["chromium", "firefox", "webkit"],
          "description": "Browser to use for automation"
        },
        "playclone.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run browser in headless mode"
        },
        "playclone.slowMo": {
          "type": "number",
          "default": 0,
          "description": "Slow down operations by milliseconds"
        },
        "playclone.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Default timeout in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "playclone": "file:.."
  }
}