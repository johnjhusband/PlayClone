# PlayClone Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# General Configuration
NODE_ENV=production
VERSION=1.1.0
DOMAIN=playclone.example.com
ADMIN_EMAIL=admin@example.com

# Docker Registry (for production)
DOCKER_REGISTRY=ghcr.io/yourusername

# PlayClone Configuration
PLAYCLONE_HEADLESS=true
PLAYCLONE_BROWSER=chromium
PLAYCLONE_MAX_SESSIONS=50
PLAYCLONE_SESSION_TIMEOUT=600000
PLAYCLONE_DEBUG=false

# Redis Configuration
REDIS_PASSWORD=your-redis-password-here
REDIS_MAX_CLIENTS=10000

# Security
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
API_KEY=your-api-key-here

# Monitoring
GRAFANA_PASSWORD=your-grafana-password-here
PROMETHEUS_RETENTION_DAYS=30

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
S3_BACKUP_BUCKET=playclone-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Resource Limits
MAX_MEMORY_PER_BROWSER=512M
MAX_CPU_PER_BROWSER=1
MAX_BROWSERS_PER_NODE=10

# Network Configuration
ENABLE_IPV6=false
NETWORK_SUBNET=172.28.0.0/16

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# Performance
ENABLE_CACHE=true
CACHE_TTL=3600
CONNECTION_POOL_SIZE=20
ENABLE_COMPRESSION=true

# Feature Flags
ENABLE_METRICS=true
ENABLE_MONITORING=true
ENABLE_BACKUP=true
ENABLE_SSL=true