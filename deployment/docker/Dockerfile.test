# Dockerfile for PlayClone Test Environment
# Includes all dependencies needed for running tests

FROM node:20-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    # Test-specific tools
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm ci

# Install all Playwright browsers for testing
RUN npx playwright install chromium firefox webkit

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Create test user
RUN groupadd -r testuser && useradd -r -g testuser testuser \
    && chown -R testuser:testuser /app

USER testuser

# Set test environment
ENV NODE_ENV=test
ENV CI=true

# Default command runs all tests
CMD ["npm", "test"]